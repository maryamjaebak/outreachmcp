# Copy to .env and fill in. Never commit the real .env.

# SearXNG instance used by search_web (docker-compose.yml starts one locally)
SEARXNG_URL=http://localhost:8080

# SQLite cache/leads database path
DATABASE_PATH=./outreach.db

# Lead-scoring rubric weights (see config/config.yaml)
CONFIG_PATH=./config/config.yaml
